class parse_yaml_file:
    def parse_info(self):
        file_handler = open("../setup/m.yml", "r")
        file_info = file_handler.read()
        try:
            self.yaml_dict = yaml.load(file_info, Loader=yaml.FullLoader)
        except AttributeError:
            self.yaml_dict = yaml.load(file_info)

        self.set_env_dict = ''
        self.rtl_filelist_dict = ''
        self.vcs_default_comp_args= ''
        self.vcs_only_pre_comp_args= ''
        self.vcs_only_post_comp_args= ''
        self.vcs_pa_comp_args= ''
        self.vcs_default_sim_args= ''
        self.vhdlan_default_comp_args= ''
        self.vlogan_default_comp_args= ''
        self.vlogan_only_pre_comp_args= ''
        self.vlogan_only_post_comp_args= ''
        self.pre_sim_duv_vhdl_flist= ''
        self.is_mixed= ''
        self.upf_cfg_path= ''
        self.vendor_ip_config = {}

        for key, value in self.yaml_dict.items():
            if key == "regression_cmd":
                self.regression_cmd = ''
                if isinstance(value, str):
                    self.regression_cmd = value
                continue
            if key == "lsf_args":
                self.lsf_args = ''
                if isinstance(value, str):
                    self.lsf_args = value
                continue
            if key == "mixsim_lsf_args":
                self.mixsim_lsf_args = ''
                if isinstance(value, str):
                    self.mixsim_lsf_args = value
                continue
            if key == "upf_file_path":
                self.upf_file_path = ''
                if isinstance(value, str):
                    self.upf_file_path = value
                continue
            if key == "upf_cfg_path":
                self.upf_cfg_path = ''
                if isinstance(value, str):
                    self.upf_cfg_path = value
                continue
            if key == "common_additional_args":
                self.common_additional_args = ''
                if isinstance(value, str):
                    self.common_additional_args = value
                continue

            if key == "set_env":
                if self.yaml_dict["set_env"] != None:
                    self.set_env_dict = self.yaml_dict["set_env"]
                continue

            if key == "rtl_filelist":
                if self.yaml_dict["rtl_filelist"] != None:
                    self.rtl_filelist_dict = self.yaml_dict["rtl_filelist"]
                continue

            if key == "vcs_default_comp_args":
                if self.yaml_dict["vcs_default_comp_args"] != None:
                    self.vcs_default_comp_args= self.yaml_dict["vcs_default_comp_args"]
                continue

            if key == "vcs_only_pre_comp_args":
                if self.yaml_dict["vcs_only_pre_comp_args"] != None:
                    self.vcs_only_pre_comp_args= self.yaml_dict["vcs_only_pre_comp_args"]
                continue

            if key == "vcs_only_post_comp_args":
                if self.yaml_dict["vcs_only_post_comp_args"] != None:
                    self.vcs_only_post_comp_args= self.yaml_dict["vcs_only_post_comp_args"]
                continue

            if key == "vcs_pa_comp_args":
                if self.yaml_dict["vcs_pa_comp_args"] != None:
                    self.vcs_pa_comp_args= self.yaml_dict["vcs_pa_comp_args"]
                continue

            if key == "vcs_default_sim_args":
                if self.yaml_dict["vcs_default_sim_args"] != None:
                    self.vcs_default_sim_args= self.yaml_dict["vcs_default_sim_args"]
                continue

            if key == "vhdlan_default_comp_args":
                if self.yaml_dict["vhdlan_default_comp_args"] != None:
                    self.vhdlan_default_comp_args= self.yaml_dict["vhdlan_default_comp_args"]
                continue

            if key == "vlogan_default_comp_args":
                if self.yaml_dict["vlogan_default_comp_args"] != None:
                    self.vlogan_default_comp_args= self.yaml_dict["vlogan_default_comp_args"]
                continue

            if key == "vlogan_only_pre_comp_args":
                if self.yaml_dict["vlogan_only_pre_comp_args"] != None:
                    self.vlogan_only_pre_comp_args= self.yaml_dict["vlogan_only_pre_comp_args"]
                continue

            if key == "vlogan_only_post_comp_args":
                if self.yaml_dict["vlogan_only_post_comp_args"] != None:
                    self.vlogan_only_post_comp_args= self.yaml_dict["vlogan_only_post_comp_args"]
                continue

            if key == "pre_sim_duv_vhdl_flist":
                if self.yaml_dict["pre_sim_duv_vhdl_flist"] != None:
                    self.pre_sim_duv_vhdl_flist= self.yaml_dict["pre_sim_duv_vhdl_flist"]
                continue

            if key == "is_mixed":
                if self.yaml_dict["is_mixed"] != None:
                    self.is_mixed= self.yaml_dict["is_mixed"]
                continue

            if key == "upf_cfg_path":
                if self.yaml_dict["upf_cfg_path"] != None:
                    self.upf_cfg_path= self.yaml_dict["upf_cfg_path"]
                continue

            if key == "vendor_ip":
                if self.yaml_dict["vendor_ip"] != None:
                    self.vendor_ip_config = self.yaml_dict["vendor_ip"]
                continue

            PubFunc.print_err("%s not support in m.yml !\n" % key)

