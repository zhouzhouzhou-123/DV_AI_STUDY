`ifndef {{ name_upper }}_SEQ__SV
`define {{ name_upper }}_SEQ__SV

class {{ name }}_seq extends uvm_sequence#({{ name }}_item);

    {{ name }}_item mo_item;

    `uvm_object_utils_begin({{ name }}_seq)
        `uvm_field_object(mo_item, UVM_ALL_ON)
    `uvm_object_utils_end

    function new(string name = "{{ name }}_seq");
        super.new(name);
        mo_item = {{ name }}_item::type_id::create("mo_item");
    endfunction : new

