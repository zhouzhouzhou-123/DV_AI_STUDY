{{ file_header }}

`ifndef ENV__SV
`define ENV__SV

class env extends uvm_env;
{% for m in members %}
    {{ m.type_aligned }}{{ m.name }};
{% endfor %}

    `uvm_component_utils_begin(env)
        `uvm_field_object(mo_vir_seqr, UVM_ALL_ON)
        `uvm_field_object(mo_regmodel, UVM_ALL_ON)
        `uvm_field_object(mo_env_cfg, UVM_ALL_ON)
{% for a in mst_agents_non_vip %}
{% if a.count == 1 %}
        `uvm_field_object(mo_{{ a.name }}_master_agent, UVM_ALL_ON)
{% else %}
        `uvm_field_sarray_object(moa_{{ a.name }}_master_agent, UVM_ALL_ON)
{% endif %}
{% endfor %}
{% for a in slv_agents_non_vip %}
{% if a.count == 1 %}
        `uvm_field_object(mo_{{ a.name }}_slaver_agent, UVM_ALL_ON)
{% else %}
        `uvm_field_sarray_object(moa_{{ a.name }}_slaver_agent, UVM_ALL_ON)
{% endif %}
{% endfor %}
{% for r in refm_list %}
        `uvm_field_object(mo_{{ r.name }}_refm, UVM_ALL_ON)
{% endfor %}
{% for s in scb_list %}
        `uvm_field_object(mo_{{ s.name }}_scb, UVM_ALL_ON)
{% endfor %}
    `uvm_component_utils_end

    function new(string name = "env", uvm_component parent = null);
        super.new(name, parent);
    endfunction : new

    extern virtual function void build_phase(uvm_phase phase);
    extern virtual function void create_agent();
    extern virtual function void create_refm();
    extern virtual function void create_scb();
    extern virtual function void config_regmodel();
    extern virtual function void config_env();

    extern virtual function void connect_phase(uvm_phase phase);

endclass : env

function void env::build_phase(uvm_phase phase);
    super.build_phase(phase);
    // config reg model
    this.config_regmodel();

    // config_env
    this.config_env();

    // virtual sequencer
    this.mo_vir_seqr = vir_seqr::type_id::create("mo_vir_seqr", this);

    // create agent
    this.create_agent();

    // create refm
    this.create_refm();

    // create scoreboard
    this.create_scb();
endfunction : build_phase

function void env::config_env();
    // get env_cfg
    if(!uvm_config_db#(env_cfg)::get(this, "", "mo_env_cfg", this.mo_env_cfg))
    begin
        `uvm_fatal(get_type_name(), "fail get mo_env_cfg!")
    end
{% for a in mst_agents_non_vip %}
{% if a.count == 1 %}
    uvm_config_db#({{ a.name }}_agent_cfg)::set(this, "mo_{{ a.name }}_master_agent.*", "mo_agent_cfg", this.mo_env_cfg.mo_{{ a.name }}_master_agent_cfg);
{% else %}
{% for i in range(a.count) %}
    uvm_config_db#({{ a.name }}_agent_cfg)::set(this, "moa_{{ a.name }}_master_agent[{{ i }}].*", "mo_agent_cfg", this.mo_env_cfg.moa_{{ a.name }}_master_agent_cfg[{{ i }}]);
{% endfor %}
{% endif %}
{% endfor %}
{% for a in slv_agents_non_vip %}
{% if a.count == 1 %}
    uvm_config_db#({{ a.name }}_agent_cfg)::set(this, "mo_{{ a.name }}_slaver_agent.*", "mo_agent_cfg", this.mo_env_cfg.mo_{{ a.name }}_slaver_agent_cfg);
{% else %}
{% for i in range(a.count) %}
    uvm_config_db#({{ a.name }}_agent_cfg)::set(this, "moa_{{ a.name }}_slaver_agent[{{ i }}].*", "mo_agent_cfg", this.mo_env_cfg.moa_{{ a.name }}_slaver_agent_cfg[{{ i }}]);
{% endfor %}
{% endif %}
{% endfor %}

endfunction : config_env

function void env::create_agent();
{% for a in mst_agents_non_vip %}
{% if a.count == 1 %}
    this.mo_{{ a.name }}_master_agent = {{ a.name }}_agent::type_id::create("mo_{{ a.name }}_master_agent", this);
{% else %}
{% for i in range(a.count) %}
    this.moa_{{ a.name }}_master_agent[{{ i }}] = {{ a.name }}_agent::type_id::create("moa_{{ a.name }}_master_agent[{{ i }}]", this);
{% endfor %}
{% endif %}
{% endfor %}
{% for a in slv_agents_non_vip %}
{% if a.count == 1 %}
    this.mo_{{ a.name }}_slaver_agent = {{ a.name }}_agent::type_id::create("mo_{{ a.name }}_slaver_agent", this);
{% else %}
{% for i in range(a.count) %}
    this.moa_{{ a.name }}_slaver_agent[{{ i }}] = {{ a.name }}_agent::type_id::create("moa_{{ a.name }}_slaver_agent[{{ i }}]", this);
{% endfor %}
{% endif %}
{% endfor %}
endfunction : create_agent

function void env::create_refm();
{% for r in refm_list %}
    this.mo_{{ r.name }}_refm = {{ r.name }}_refm::type_id::create("mo_{{ r.name }}_refm", this);
{% endfor %}
endfunction : create_refm

function void env::create_scb();
{% for s in scb_list %}
    this.mo_{{ s.name }}_scb = {{ s.name }}_scb::type_id::create("mo_{{ s.name }}_scb", this);
{% endfor %}
endfunction : create_scb

function void env::config_regmodel();
    this.mo_regmodel= ral_regmodel::type_id::create("mo_regmodel", this);
    this.mo_regmodel.configure(null, "");
    this.mo_regmodel.build();
    this.mo_regmodel.lock_model();
    this.mo_regmodel.reset();

    uvm_config_db#(ral_regmodel)::set(this, "*", "mo_regmodel", this.mo_regmodel);
endfunction : config_regmodel

function void env::connect_phase(uvm_phase phase);
    this.mo_regmodel.default_map.set_auto_predict(1);
{% for a in mst_agents_non_vip %}
{% if a.count == 1 %}
    this.mo_vir_seqr.mo_{{ a.name }}_seqr = this.mo_{{ a.name }}_master_agent.mo_seqr;
{% else %}
{% for i in range(a.count) %}
    this.mo_vir_seqr.moa_{{ a.name }}_seqr[{{ i }}] = this.moa_{{ a.name }}_master_agent[{{ i }}].mo_seqr;
{% endfor %}
{% endif %}
{% endfor %}
endfunction : connect_phase

`endif // ENV__SV
